---
import BaseLayout from './BaseLayout.astro';
import { SITE_TITLE } from '../consts';

const { title, description, status, repository, framework, modelSize, compute, startDate } = Astro.props;
---

<BaseLayout title={`${title} | Projects | ${SITE_TITLE}`} description={description}>
    <article>
        <header>
            <h1>{title}</h1>
            <p class="description">{description}</p>
            <hr />
        </header>

        <section class="dashboard-grid">
            <div class="metric-card">
                <span class="metric-label">System Status</span>
                <span class="metric-value"><span class="status-badge">{status}</span></span>
            </div>
            <div class="metric-card">
                <span class="metric-label">Core Framework</span>
                <span class="metric-value">{framework}</span>
            </div>
            {modelSize && (
                <div class="metric-card">
                    <span class="metric-label">Architecture / Size</span>
                    <span class="metric-value">{modelSize}</span>
                </div>
            )}
            {compute && (
                <div class="metric-card">
                    <span class="metric-label">Training Compute</span>
                    <span class="metric-value">{compute}</span>
                </div>
            )}
            {repository && (
                <div class="metric-card">
                    <span class="metric-label">Repository</span>
                    <a href={repository} target="_blank" class="metric-value">View Source ↗</a>
                </div>
            )}
        </section>

        <div class="project-content">
            <slot />
        </div>
    </article>
</BaseLayout>

<style>
    h1 {
        color: var(--black);
    }
    .description {
        color: var(--gray-slate);
    }
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
        padding: 1.5rem;
        background-color: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
    }
    .metric-card {
        display: flex;
        flex-direction: column;
    }
    .metric-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--gray-muted);
        margin-bottom: 0.25rem;
    }
    .metric-value {
        font-family: var(--font-mono);
        font-weight: bold;
        font-size: 1.1rem;
        color: var(--black);
    }
    .status-badge {
        display: inline-block;
        padding: 0.25rem 0.5rem;
        font-size: 0.85rem;
        font-family: var(--font-mono);
        background: var(--bg-muted);
        color: var(--gray-slate);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-light);
    }
    .project-content {
        line-height: 1.6;
        color: var(--gray-slate);
    }
    .project-content :global(h1),
    .project-content :global(h2),
    .project-content :global(h3),
    .project-content :global(h4) {
        color: var(--black);
    }
    .project-content :global(p),
    .project-content :global(li) {
        color: var(--gray-slate);
    }
</style>