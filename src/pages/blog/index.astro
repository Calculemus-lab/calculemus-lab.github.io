---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);
---

<BaseLayout title={`Blog & Journal | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<div class="journal-container">
		<!-- Header -->
		<header class="journal-header reveal-on-scroll">
			<h2>Calculemus Journal</h2>
			<p class="journal-subtitle">Articles, hackathon recaps, tech interviews, and AI developments from our engineering team.</p>
			<hr />
		</header>

		<!-- Featured Showcase Post -->
		{
			featuredPost && (
				<section class="featured-section reveal-on-scroll">
					<div class="featured-card">
						<div class="featured-image-col">
							{featuredPost.data.heroImage && (
								<Image width={720} height={400} src={featuredPost.data.heroImage} alt={featuredPost.data.title} />
							)}
						</div>
						<div class="featured-content-col">
							<span class="badge-featured">FEATURED ARTICLE</span>
							<h3 class="featured-title">
								<a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
							</h3>
							<p class="featured-description">{featuredPost.data.description}</p>
							<div class="featured-meta">
								<span class="date">
									<FormattedDate date={featuredPost.data.pubDate} />
								</span>
								<a href={`/blog/${featuredPost.id}/`} class="read-btn">
									Read Article &rarr;
								</a>
							</div>
						</div>
					</div>
				</section>
			)
		}

		<!-- Grid of Remaining Posts -->
		{
			remainingPosts.length > 0 && (
				<section class="grid-section">
					<h3 class="section-heading reveal-on-scroll">Recent Articles</h3>
					<div class="posts-grid">
						{remainingPosts.map((post) => (
							<article class="post-grid-card reveal-on-scroll">
								<a href={`/blog/${post.id}/`} class="card-link">
									{post.data.heroImage && (
										<div class="card-image-wrap">
											<Image width={500} height={260} src={post.data.heroImage} alt={post.data.title} />
										</div>
									)}
									<div class="card-body">
										<span class="category-pill">ARTICLE</span>
										<h4 class="card-title">{post.data.title}</h4>
										<p class="card-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</article>
						))}
					</div>
				</section>
			)
		}
	</div>
</BaseLayout>

<style>
	.journal-container {
		max-width: var(--max-width-container);
		margin: 0 auto;
	}

	.journal-header {
		margin-bottom: 2.5rem;
	}

	.journal-header h2 {
		font-size: 2.5rem;
		color: var(--black);
		margin-bottom: 0.5rem;
	}

	.journal-subtitle {
		font-size: 1.1rem;
		color: var(--gray-slate);
		margin-bottom: 1.5rem;
	}

	/* Featured Card Showcase */
	.featured-section {
		margin-bottom: 4rem;
	}

	.featured-card {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 2rem;
		background: var(--bg-card);
		border: 1px solid var(--border-subtle);
		border-left: 4px solid var(--accent);
		border-radius: var(--radius-lg);
		padding: 1.75rem;
		backdrop-filter: blur(10px);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
		transition: border-color 0.3s ease, background 0.3s ease;
	}

	.featured-card:hover {
		border-color: var(--border-accent);
		background: var(--bg-card-hover);
	}

	.featured-image-col img {
		width: 100%;
		height: 100%;
		max-height: 320px;
		object-fit: cover;
		border-radius: var(--radius-md);
		display: block;
	}

	.featured-content-col {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.badge-featured {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent);
		background: var(--bg-muted);
		padding: 0.25rem 0.6rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border-accent);
		margin-bottom: 0.75rem;
		align-self: flex-start;
		letter-spacing: 0.05em;
	}

	.featured-title {
		font-size: 1.8rem;
		line-height: 1.25;
		margin: 0 0 0.75rem 0;
	}

	.featured-title a {
		color: var(--black);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.featured-title a:hover {
		color: var(--accent);
	}

	.featured-description {
		color: var(--gray-slate);
		font-size: 1rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.featured-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-top: 1px solid var(--border-subtle);
		padding-top: 1rem;
	}

	.featured-meta .date {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.read-btn {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		transition: transform 0.2s ease;
	}

	.read-btn:hover {
		transform: translateX(4px);
	}

	/* Recent Articles Grid */
	.section-heading {
		font-size: 1.6rem;
		color: var(--black);
		margin-bottom: 1.5rem;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.75rem;
	}

	.post-grid-card {
		background: var(--bg-card);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-md);
		overflow: hidden;
		transition: border-color 0.25 ease, transform 0.25s ease, background 0.25s ease;
		backdrop-filter: blur(10px);
	}

	.post-grid-card:hover {
		border-color: var(--border-accent);
		background: var(--bg-card-hover);
		transform: translateY(-3px);
	}

	.card-link {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.card-image-wrap img {
		width: 100%;
		height: 170px;
		object-fit: cover;
		display: block;
	}

	.card-body {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.category-pill {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--accent);
		text-transform: uppercase;
		margin-bottom: 0.5rem;
		letter-spacing: 0.05em;
	}

	.card-title {
		font-size: 1.2rem;
		line-height: 1.3;
		color: var(--black);
		margin: 0 0 1rem 0;
		flex: 1;
		transition: color 0.2s ease;
	}

	.card-link:hover .card-title {
		color: var(--accent);
	}

	.card-date {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-muted);
		margin: 0;
	}

	@media (max-width: 768px) {
		.featured-card {
			grid-template-columns: 1fr;
		}
	}
</style>
