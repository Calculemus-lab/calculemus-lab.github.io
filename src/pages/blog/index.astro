---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);
---

<BaseLayout title={`Blog & Journal | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<div class="journal-container">
		<!-- Header -->
		<header class="journal-header reveal-on-scroll">
			<h2>Calculemus Journal</h2>
			<p class="journal-subtitle">Articles, recaps, tech interviews, and developments from our engineering team.</p>
			<hr class="header-divider" />
		</header>

		<!-- Featured Showcase Post Container -->
		{
			featuredPost && (
				<section class="featured-section reveal-on-scroll">
					<div class="featured-card">
						<div class="featured-image-col">
							{featuredPost.data.heroImage && (
								<Image width={720} height={420} src={featuredPost.data.heroImage} alt={featuredPost.data.title} />
							)}
						</div>
						<div class="featured-content-col">
							<span class="badge-featured">FEATURED ARTICLE</span>
							<h3 class="featured-title">
								<a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
							</h3>
							{featuredPost.data.description && (
								<p class="featured-description">{featuredPost.data.description}</p>
							)}
							<div class="featured-meta">
								<span class="date">
									📅 <FormattedDate date={featuredPost.data.pubDate} />
								</span>
								<a href={`/blog/${featuredPost.id}/`} class="read-btn">
									Read Article &rarr;
								</a>
							</div>
						</div>
					</div>
				</section>
			)
		}

		<!-- Distinct Section Divider -->
		{
			remainingPosts.length > 0 && (
				<section class="archive-section">
					<div class="section-header-bar reveal-on-scroll">
						<div class="section-tag">JOURNAL ARCHIVE</div>
						<h3 class="section-title">Recent Articles</h3>
					</div>

					<!-- Funky Asymmetrical Post Grid -->
					<div class="funky-posts-grid">
						{remainingPosts.map((post, index) => (
							<article class:list={["post-card", { "wide-card": index === 0 }, "reveal-on-scroll"]}>
								<a href={`/blog/${post.id}/`} class="card-inner">
									{post.data.heroImage && (
										<div class="card-image-box">
											<Image width={560} height={300} src={post.data.heroImage} alt={post.data.title} />
										</div>
									)}
									<div class="card-info">
										<div class="card-tag">ARTICLE</div>
										<h4 class="card-title">{post.data.title}</h4>
										{index === 0 && post.data.description && (
											<p class="card-excerpt">{post.data.description}</p>
										)}
										<div class="card-footer">
											<span class="card-date">
												<FormattedDate date={post.data.pubDate} />
											</span>
											<span class="read-arrow">&rarr;</span>
										</div>
									</div>
								</a>
							</article>
						))}
					</div>
				</section>
			)
		}
	</div>
</BaseLayout>

<style>
	.journal-container {
		max-width: var(--max-width-container);
		margin: 0 auto;
	}

	.journal-header {
		margin-bottom: 3rem;
	}

	.journal-header h2 {
		font-size: 2.5rem;
		color: var(--black);
		margin-bottom: 0.5rem;
	}

	.journal-subtitle {
		font-size: 1.1rem;
		color: var(--gray-slate);
		margin-bottom: 1.5rem;
	}

	.header-divider {
		border: 0;
		border-top: 1px solid var(--border-subtle);
		margin: 1.5rem 0 0 0;
	}

	/* Featured Showcase Container */
	.featured-section {
		margin-bottom: 5.5rem;
	}

	.featured-card {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 2.5rem;
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid var(--border-accent);
		border-radius: var(--radius-lg);
		padding: 2.25rem;
		backdrop-filter: blur(14px);
		box-shadow: 0 10px 35px rgba(0, 0, 0, 0.05);
		transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
	}

	.featured-card:hover {
		transform: translateY(-4px);
		background: rgba(255, 255, 255, 0.98);
		border-color: var(--accent);
		box-shadow: 0 16px 45px var(--accent-glow);
	}

	.featured-image-col img {
		width: 100%;
		height: 100%;
		min-height: 280px;
		max-height: 360px;
		object-fit: cover;
		border-radius: var(--radius-md);
		display: block;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
	}

	.featured-content-col {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.badge-featured {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent);
		background: var(--bg-muted);
		padding: 0.3rem 0.75rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border-accent);
		margin-bottom: 1rem;
		align-self: flex-start;
		letter-spacing: 0.08em;
	}

	.featured-title {
		font-size: 2rem;
		line-height: 1.2;
		margin: 0 0 1rem 0;
	}

	.featured-title a {
		color: var(--accent);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.featured-title a:hover {
		color: var(--accent-hover);
	}

	.featured-description {
		color: var(--gray-slate);
		font-size: 1.05rem;
		line-height: 1.65;
		margin-bottom: 1.75rem;
	}

	.featured-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-top: 1px solid var(--border-subtle);
		padding-top: 1.25rem;
	}

	.featured-meta .date {
		font-size: 0.9rem;
		color: var(--gray-slate);
	}

	.read-btn {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		transition: transform 0.2s ease;
	}

	.read-btn:hover {
		transform: translateX(4px);
	}

	/* Section Separator & Heading */
	.archive-section {
		margin-top: 2rem;
	}

	.section-header-bar {
		border-top: 2px dashed var(--border-subtle);
		padding-top: 2.5rem;
		margin-bottom: 2.5rem;
	}

	.section-tag {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--gray-muted);
		letter-spacing: 0.1em;
		margin-bottom: 0.25rem;
	}

	.section-title {
		font-size: 2rem;
		color: var(--black);
		margin: 0;
	}

	/* Funky Asymmetrical Grid */
	.funky-posts-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}

	.post-card {
		background: rgba(255, 255, 255, 0.8);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-lg);
		overflow: hidden;
		backdrop-filter: blur(10px);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.03);
		transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
	}

	.post-card:hover {
		transform: translateY(-5px);
		background: #ffffff;
		border-color: var(--accent);
		box-shadow: 0 16px 45px var(--accent-glow);
	}

	/* Funky Wide Card (First remaining post spans full width) */
	.post-card.wide-card {
		grid-column: span 2;
	}

	.post-card.wide-card .card-inner {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
	}

	.post-card.wide-card .card-image-box img {
		height: 100%;
		max-height: 280px;
	}

	.card-inner {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.card-image-box img {
		width: 100%;
		height: 210px;
		object-fit: cover;
		display: block;
	}

	.card-info {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.card-tag {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: 0.05em;
		margin-bottom: 0.5rem;
	}

	.card-title {
		font-size: 1.35rem;
		line-height: 1.3;
		color: var(--black);
		margin: 0 0 0.75rem 0;
		flex: 1;
		transition: color 0.2s ease;
	}

	.card-inner:hover .card-title {
		color: var(--accent);
	}

	.card-excerpt {
		font-size: 0.95rem;
		color: var(--gray-slate);
		line-height: 1.5;
		margin-bottom: 1.25rem;
	}

	.card-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-top: 1px solid var(--border-subtle);
		padding-top: 0.75rem;
		margin-top: auto;
	}

	.card-date {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--gray-slate);
	}

	.read-arrow {
		font-size: 1.1rem;
		color: var(--accent);
		transition: transform 0.2s ease;
	}

	.card-inner:hover .read-arrow {
		transform: translateX(4px);
	}

	@media (max-width: 768px) {
		.featured-card {
			grid-template-columns: 1fr;
		}
		.funky-posts-grid {
			grid-template-columns: 1fr;
		}
		.post-card.wide-card {
			grid-column: span 1;
		}
		.post-card.wide-card .card-inner {
			grid-template-columns: 1fr;
		}
	}
</style>
